# Supabase — Nodexa Core
# Copiá este archivo como .env.local y completá los valores reales del proyecto
# (Supabase Dashboard > Project Settings > API / Database). Nunca commitear .env.local.

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API > Project API keys > service_role (secreta, sin prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings > Database > Connection string > URI (usada solo por npm run db:verificar)
SUPABASE_DB_URL=

# Upstash Redis — Rate limiting de login y recuperación de contraseña
# (console.upstash.com > tu base de datos > REST API). Obligatorias.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry — Monitoreo técnico (Settings > Client Keys (DSN) del proyecto en sentry.io)
# El DSN es público por diseño (solo permite enviar eventos, no leerlos).
NEXT_PUBLIC_SENTRY_DSN=

# Sentry — usadas solo en build time por withSentryConfig para subir source maps
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Nave Nodriza — telemetría de negocio externa (AppyStudio). Opcionales: si faltan,
# src/lib/analytics/nave-nodriza.ts queda en no-op silencioso, la app no falla.
# Registrar "Nodexa Core" como tenant en el panel de Nave Nodriza para obtenerlas.
NEXT_PUBLIC_NN_CLIENT_ID=
NEXT_PUBLIC_NN_API_KEY=
NEXT_PUBLIC_NN_ENDPOINT=https://nave-nodriza-catalogo.vercel.app/api/telemetry/traffic
